# Sao chép thành .env rồi đổi các giá trị. KHÔNG commit file .env.

# --- PostgreSQL (chạy kèm trong compose) ---
POSTGRES_DB=trucca
POSTGRES_USER=trucca
# Dùng chữ/số/-/_ để không phải URL-encode trong DATABASE_URL
POSTGRES_PASSWORD=doi-mat-khau-nay

# --- Tài khoản quản trị đầu tiên (chỉ dùng khi DB chưa có người dùng nào) ---
# Bỏ trống thì mặc định admin / admin. Luôn bắt buộc đổi mật khẩu ở lần đăng nhập đầu tiên.
TRUCCA_ADMIN_USERNAME=
TRUCCA_ADMIN_PASSWORD=

# --- Xác thực tới Alertmanager (tuỳ chọn, xem alertmanager.auth.type trong config.yml) ---
ALERTMANAGER_USERNAME=
ALERTMANAGER_PASSWORD=
ALERTMANAGER_TOKEN=

# --- Image ---
TRUCCA_IMAGE=registry.local/noc/trucca
TRUCCA_VERSION=2.0.0

# Cổng trên máy host
TRUCCA_PORT=8080

# Cổng mock Alertmanager trên host (chỉ dùng với profile demo)
MOCK_AM_PORT=19093
